# Copy this file to ".env" and fill in real values. Never commit the real ".env" file.

# MongoDB Atlas connection string. If left unset, the app automatically
# falls back to an in-memory store so you can run everything locally
# without setting up a database first.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority

DB_NAME=civic_grievance_db

# Comma-separated list of frontend origins allowed to call this API.
# Use * for local development; restrict this in production.
ALLOWED_ORIGINS=*
